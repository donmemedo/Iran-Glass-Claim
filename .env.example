# Copy to .env and fill in both values; compose refuses to start while they are empty.
# Shared by the backend (to check) and the frontend proxy (to send). Never exposed to browsers. 24+ characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INSURER_TOKEN=
# The insurer panel password (/dashboard). 12+ characters; a long passphrase is best.
DASHBOARD_PASSWORD=
# 1 (default) when a reverse proxy in front of the frontend sets X-Forwarded-For; 0 when there is none.
TRUST_PROXY=1
