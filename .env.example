# Copy to .env and replace both values. Generate the token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Shared by the backend (to check) and the frontend proxy (to send). Never exposed to browsers.
INSURER_TOKEN=change-me
# The insurer panel password (/dashboard). Use a long passphrase.
DASHBOARD_PASSWORD=change-me
# Set to 1 only when a reverse proxy in front of the frontend sets X-Forwarded-For.
TRUST_PROXY=0
